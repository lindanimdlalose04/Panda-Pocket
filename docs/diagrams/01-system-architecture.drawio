        <mxCell id="pgLabel" value="One PostgreSQL 16 container. Three databases, one login role each,&#10;CONNECT revoked from PUBLIC. A role cannot reach another&#39;s database." style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#000000;" vertex="1" parent="1">
