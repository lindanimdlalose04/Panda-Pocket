        <mxCell id="p2Label" value="Phase 2: the security layer. Downstream of everything and upstream of nothing, so it can never block a payment." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="70" y="660" width="900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="socService" value="&lt;b&gt;SOC service&lt;/b&gt; : 8080&#xa;&#xa;receives security events from every service&#xa;six detection rules, raw SQL, on a 20s timer&#xa;raises and updates alerts, suppression per source&#xa;groups related alerts into incidents" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontColor=#000000;fontSize=11;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="690" width="390" height="110" as="geometry" />
        </mxCell>
        <mxCell id="graphService" value="&lt;b&gt;Graph service&lt;/b&gt; : 8080&#xa;&#xa;builds the knowledge graph from three sources&#xa;RAG: retrieve then generate&#xa;three retrieval routes (Cypher, vector, hybrid)&#xa;evidence envelope returned with every answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontColor=#000000;fontSize=11;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="560" y="690" width="390" height="110" as="geometry" />
