        <mxCell id="seq" value="&lt;b&gt;Seq&lt;/b&gt;&#xa;centralised structured logging&#xa;every service ships Serilog events&#xa;stamped with X-Correlation-Id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=10;dashed=1;" parent="1" vertex="1">
