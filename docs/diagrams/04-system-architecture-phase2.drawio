        <mxCell id="dockerLabel" value="Docker Compose network &quot;pandapocket&quot;, twelve containers. Routes name a service; Consul answers with the healthy instances registered under that name." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="50" y="180" width="1200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="consulBox" value="&lt;b&gt;Consul&lt;/b&gt;  service registry&#xa;&#xa;each service registers itself on startup&#xa;and deregisters on shutdown&#xa;health check polled every 10s&#xa;UI on :8500" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="60" y="210" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt; (Ocelot) : 8080&#xa;&#xa;routing by path  ·  API key authentication  ·  rate limiting (429)&#xa;correlation id minted here  ·  serves the client pages&#xa;&lt;b&gt;new:&lt;/b&gt; routes /api/soc/* and /api/graph/* read only;&#xa;event ingestion and the graph loaders are deliberately not routed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=11;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="540" y="205" width="430" height="110" as="geometry" />
        </mxCell>
