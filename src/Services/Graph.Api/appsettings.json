{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Neo4j": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Seq": { "ServerUrl": "http://localhost:5341" },
  "Graph": {
    "Uri": "bolt://localhost:7687",
    "Username": "neo4j",
    "Password": "panda_graph_dev",
    "ConsulUrl": "http://localhost:8500",
    "OcelotConfigPath": "/app/config/ocelot.json",
    "SocBaseUrl": "http://localhost:5005",
    "AutoLoadOnStartup": true,

    "//Dependencies": [
      "Declared, not discovered. Nothing in the registry knows that one service",
      "calls another until a call fails, and inferring these from circuit-breaker",
      "events would mean the graph only learns about a dependency at the moment",
      "it breaks. Every other edge in the application subgraph is read from the",
      "running system; these are the exception and are marked source='declared'",
      "on the relationship so the distinction survives into the graph."
    ],
    "Dependencies": [
      "gateway -> merchant-service",
      "gateway -> invoice-service",
      "gateway -> rate-service",
      "gateway -> settlement-service",
      "invoice-service -> rate-service",
      "invoice-service -> settlement-service",
      "settlement-service -> merchant-service",
      "soc-service -> consul"
    ]
  },
  "AllowedHosts": "*"
}
