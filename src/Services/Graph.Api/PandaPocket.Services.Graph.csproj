<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Contracts\PandaPocket.Shared.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official driver. Cypher is written by hand rather than through an
         OGM: the specification asks for the retrieval process to be explained,
         and a mapping layer would put something between the query and what the
         report documents. -->
    <PackageReference Include="Neo4j.Driver" Version="5.26.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
